<!-- CTA Section -->
<section class="w-full cta-section py-24 px-margin-mobile text-center relative z-10 mt-12 mb-32">
  <div class="max-w-3xl mx-auto" data-animate="fade-up">
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tighter">Optimizado para estudios jurídicos y abogados independientes.</h2>
    <p class="text-xl text-gray-600 mb-10">Empieza a trabajar de manera más inteligente hoy mismo.</p>
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <button class="bg-primary text-white font-medium px-8 py-3.5 rounded-full hover:bg-primary-container transition-colors w-full sm:w-auto cursor-pointer">
        Empieza ahora
      </button>
      <button class="bg-black/5 text-gray-900 border border-black/10 font-medium px-8 py-3.5 rounded-full hover:bg-black/10 transition-colors w-full sm:w-auto cursor-pointer">
        Contactar ventas
      </button>
    </div>
  </div>
</section>
