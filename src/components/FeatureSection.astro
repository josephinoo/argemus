---
interface Props {
  title: string;
  description: string;
  image: string;
  reverse?: boolean;
  tag?: string;
}

const { title, description, image, reverse = false, tag } = Astro.props;
---
<section class={`feature ${reverse ? 'reverse' : ''}`} id="soluciones">
  <div class="container feature-grid">
    <div class="feature-text">
      {tag && <span class="tag">{tag}</span>}
      <h2 class="feature-title">{title}</h2>
      <p class="feature-description">{description}</p>
      <ul class="feature-list">
        <li>Búsqueda semántica en bases de datos legales</li>
        <li>Análisis de riesgos contractuales automatizado</li>
        <li>Generación de borradores de alta precisión</li>
      </ul>
      <a href="#" class="feature-link">Explorar Capacidades →</a>
    </div>
    <div class="feature-image">
      <img src={image} alt={title} />
      <div class="image-accent"></div>
    </div>
  </div>
</section>

<style>
  .feature {
    background-color: var(--color-black);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .reverse .feature-grid {
    direction: rtl;
  }

  .reverse .feature-text {
    direction: ltr;
  }

  .tag {
    color: var(--color-accent);
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 2px;
    margin-bottom: 1rem;
    display: block;
  }

  .feature-title {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }

  .feature-description {
    font-size: 1.1rem;
    color: var(--color-gray-200);
    margin-bottom: 2rem;
  }

  .feature-list {
    list-style: none;
    margin-bottom: 2.5rem;
  }

  .feature-list li {
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-gray-100);
  }

  .feature-list li::before {
    content: "•";
    color: var(--color-accent);
    font-weight: bold;
  }

  .feature-link {
    font-weight: 600;
    color: var(--color-white);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 4px;
  }

  .feature-image {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  .feature-image img {
    width: 100%;
    display: block;
    transition: transform 0.5s ease;
  }

  .feature-image:hover img {
    transform: scale(1.05);
  }

  .image-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, rgba(212, 175, 55, 0.1) 0%, transparent 100%);
    pointer-events: none;
  }

  @media (max-width: 992px) {
    .feature-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .feature-list li {
      justify-content: center;
    }
    .reverse .feature-grid {
      direction: ltr;
    }
  }
</style>
