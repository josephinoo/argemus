---
const features = [
  {
    icon: 'search_insights',
    title: 'Búsqueda Semántica',
    description: 'Encuentra jurisprudencia por concepto o problema jurídico, no solo por palabras clave exactas.'
  },
  {
    icon: 'bolt',
    title: 'Resultados en Segundos',
    description: 'Reduce horas de investigación a milisegundos gracias a nuestra infraestructura de IA de baja latencia.'
  },
  {
    icon: 'gavel',
    title: 'Precisión Legal',
    description: 'Modelos entrenados específicamente con corpus legal ecuatoriano para garantizar relevancia y exactitud.'
  },
  {
    icon: 'summarize',
    title: 'Resúmenes Automáticos',
    description: 'Extrae la ratio decidendi y los puntos clave de sentencias de cientos de páginas al instante.'
  },
  {
    icon: 'notifications_active',
    title: 'Alertas Jurisprudenciales',
    description: 'Mantente al día con cambios de criterio en la Corte Nacional y Corte Constitucional.'
  },
  {
    icon: 'verified_user',
    title: 'Privacidad Enterprise',
    description: 'Tus búsquedas e información están cifradas. Nunca entrenamos modelos con tus datos privados.'
  }
];
---

<section class="w-full max-w-6xl mx-auto py-24 px-4 md:px-8">
  <div class="text-center max-w-2xl mx-auto mb-16" data-animate="fade-up">
    <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-gray-900 mb-4">
      La ventaja competitiva para litigantes
    </h2>
    <p class="text-lg text-gray-500">
      Todo lo que necesitas para construir argumentos ganadores con respaldo jurisprudencial en una fracción del tiempo.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" data-animate-group>
    {features.map((feature) => (
      <div 
        data-animate="stagger"
        class="bg-white/60 backdrop-blur-sm border border-gray-100 p-8 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 group"
      >
        <div class="w-12 h-12 bg-gray-50 rounded-xl border border-gray-100 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-primary/5 group-hover:border-primary/10 transition-transform duration-300">
          <span class="material-symbols-outlined text-gray-700 group-hover:text-primary transition-colors" style="font-variation-settings: 'FILL' 0;">
            {feature.icon}
          </span>
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-3">{feature.title}</h3>
        <p class="text-gray-500 leading-relaxed text-sm">
          {feature.description}
        </p>
      </div>
    ))}
  </div>
</section>
