---
interface Props {
  title: string;
  description: string;
  reverse?: boolean;
  tag?: string;
  variant?: 'analysis' | 'automation';
}

const { title, description, reverse = false, tag, variant = 'analysis' } = Astro.props;
---
<section class={`feature ${reverse ? 'reverse' : ''}`} id="soluciones">
  <div class="container feature-grid">
    <div class="feature-text">
      {tag && <span class="tag">{tag}</span>}
      <h2 class="feature-title">{title}</h2>
      <p class="feature-description">{description}</p>
      <ul class="feature-list">
        <li>Búsqueda semántica en bases de datos legales</li>
        <li>Análisis de riesgos contractuales automatizado</li>
        <li>Generación de borradores de alta precisión</li>
      </ul>
      <a href="#" class="feature-link">Explorar Capacidades →</a>
    </div>
    <div class="feature-visual" aria-hidden="true">
      {variant === 'analysis' ? (
        <svg viewBox="0 0 540 360" role="img">
          <defs>
            <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#8f9dff" stop-opacity="0.38" />
              <stop offset="100%" stop-color="#8f9dff" stop-opacity="0.04" />
            </linearGradient>
          </defs>
          <rect x="20" y="20" width="500" height="320" rx="18" fill="url(#g1)" />
          <rect x="52" y="56" width="436" height="34" rx="8" fill="rgba(255,255,255,0.08)" />
          <rect x="52" y="108" width="190" height="206" rx="10" fill="rgba(255,255,255,0.06)" />
          <rect x="258" y="108" width="230" height="92" rx="10" fill="rgba(255,255,255,0.06)" />
          <rect x="258" y="220" width="108" height="94" rx="10" fill="rgba(255,255,255,0.06)" />
          <rect x="380" y="220" width="108" height="94" rx="10" fill="rgba(255,255,255,0.06)" />
          <path d="M78 178 C120 130, 170 210, 220 160" stroke="#c3ccff" stroke-width="4" fill="none" />
          <circle cx="220" cy="160" r="6" fill="#c3ccff" />
        </svg>
      ) : (
        <svg viewBox="0 0 540 360" role="img">
          <defs>
            <linearGradient id="g2" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#9fb2ff" stop-opacity="0.3" />
              <stop offset="100%" stop-color="#9fb2ff" stop-opacity="0.03" />
            </linearGradient>
          </defs>
          <rect x="20" y="20" width="500" height="320" rx="18" fill="url(#g2)" />
          <rect x="52" y="58" width="436" height="38" rx="10" fill="rgba(255,255,255,0.08)" />
          <rect x="52" y="114" width="436" height="54" rx="10" fill="rgba(255,255,255,0.06)" />
          <rect x="52" y="182" width="436" height="54" rx="10" fill="rgba(255,255,255,0.06)" />
          <rect x="52" y="250" width="300" height="54" rx="10" fill="rgba(255,255,255,0.06)" />
          <circle cx="76" cy="141" r="8" fill="#c3ccff" />
          <circle cx="76" cy="209" r="8" fill="#c3ccff" />
          <circle cx="76" cy="277" r="8" fill="#c3ccff" />
        </svg>
      )}
    </div>
  </div>
</section>

<style>
  .feature {
    background-color: transparent;
  }

  .feature-grid {
    max-width: 1080px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem;
    align-items: stretch;
  }

  .feature-text {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    animation: fadeUp 700ms ease both;
  }

  .reverse .feature-text {
    animation-delay: 120ms;
  }

  .reverse .feature-grid {
    direction: rtl;
  }

  .reverse .feature-text,
  .reverse .feature-visual {
    direction: ltr;
  }

  .tag {
    color: var(--color-accent-strong);
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.12em;
    margin-bottom: 1rem;
    display: block;
  }

  .feature-title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 3.5vw, 3rem);
    margin-bottom: 1rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .feature-description {
    font-size: 1rem;
    color: var(--color-muted);
    margin-bottom: 1.7rem;
  }

  .feature-list {
    list-style: none;
    margin-bottom: 2rem;
  }

  .feature-list li {
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: rgba(240, 244, 255, 0.9);
  }

  .feature-list li::before {
    content: "•";
    color: var(--color-accent);
    font-weight: bold;
  }

  .feature-link {
    font-weight: 600;
    color: var(--color-accent-strong);
    border-bottom: 1px solid var(--color-accent-strong);
    padding-bottom: 4px;
  }

  .feature-visual {
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
    animation: fadeUp 700ms ease both;
    animation-delay: 160ms;
  }

  .feature-visual svg {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 992px) {
    .feature-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .feature-list li {
      justify-content: center;
    }
    .reverse .feature-grid {
      direction: ltr;
    }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
