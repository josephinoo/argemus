---
const currentYear = new Date().getFullYear();
---
<!-- Footer -->
<footer class="border-t border-black/10 bg-surface pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 md:px-16">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-16">
      <div class="col-span-2 md:col-span-2">
        <div class="font-bold text-xl text-gray-900 mb-4 tracking-tight flex items-center gap-2">
          <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">gavel</span>
          Argemus
        </div>
        <p class="text-sm text-gray-600 max-w-[24rem]">La nueva era de la investigación legal en Ecuador. Potenciada por inteligencia artificial para equipos modernos.</p>
      </div>
      <div>
        <h4 class="text-gray-900 font-semibold mb-4 text-sm tracking-wide">Producto</h4>
        <ul class="space-y-3">
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="/">Jurisprudencia</a></li>
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="/precios">Precios</a></li>
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="#">Seguridad</a></li>
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="#">Changelog</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-gray-900 font-semibold mb-4 text-sm tracking-wide">Empresa</h4>
        <ul class="space-y-3">
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="#">Sobre nosotros</a></li>
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="/metodologia">Metodología</a></li>
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="/contacto">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-gray-900 font-semibold mb-4 text-sm tracking-wide">Legal</h4>
        <ul class="space-y-3">
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="/terminos-de-servicio">Términos de Servicio</a></li>
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="/privacidad">Privacidad</a></li>
          <li><a class="text-sm text-gray-600 hover:text-gray-900 transition-colors" href="/aviso-legal">Aviso Legal</a></li>
        </ul>
      </div>
    </div>
    
    <div class="flex flex-col md:flex-row justify-between items-center border-t border-black/10 pt-8 gap-4">
      <p class="text-sm text-gray-500">© {currentYear} Argemus. Todos los derechos reservados.</p>
      <div class="flex gap-4">
        <a class="text-gray-500 hover:text-gray-900 transition-colors" href="#">
          <span class="material-symbols-outlined text-lg">language</span>
        </a>
      </div>
    </div>
  </div>
</footer>
