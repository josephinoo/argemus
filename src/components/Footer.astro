---
---
<footer id="empresa">
  <div class="container footer-grid">
    <div class="footer-brand">
      <h2 class="footer-logo">ARGEMUS</h2>
      <p class="footer-tagline">Infraestructura legal inteligente para equipos que operan con precisión.</p>
    </div>
    <div class="footer-links">
      <div class="link-group">
        <h3>Plataforma</h3>
        <ul>
          <li><a href="#">Soluciones</a></li>
          <li><a href="#">Seguridad</a></li>
          <li><a href="#">API</a></li>
        </ul>
      </div>
      <div class="link-group">
        <h3>Compañía</h3>
        <ul>
          <li><a href="#">Sobre Nosotros</a></li>
          <li><a href="#">Carreras</a></li>
          <li><a href="#">Contacto</a></li>
        </ul>
      </div>
      <div class="link-group">
        <h3>Legal</h3>
        <ul>
          <li><a href="#">Privacidad</a></li>
          <li><a href="#">Términos</a></li>
          <li><a href="#">Ética en IA</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} Argemus. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: transparent;
    padding-top: var(--spacing-xl);
    border-top: 1px solid var(--color-border);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: var(--spacing-lg);
    margin-bottom: 2.2rem;
  }

  .footer-logo {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    margin-bottom: 1rem;
  }

  .footer-tagline {
    color: var(--color-muted);
    max-width: 360px;
    font-size: 0.95rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }

  .link-group h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .link-group ul {
    list-style: none;
  }

  .link-group li {
    margin-bottom: 0.75rem;
  }

  .link-group a {
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .link-group a:hover {
    color: var(--color-text);
  }

  .footer-bottom {
    padding: 1.2rem 0 2rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-links {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
