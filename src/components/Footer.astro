---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#e0e5eb] bg-[#faf4ec] pt-20 pb-12 w-full z-10 relative">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-20">
      
      <!-- Brand & Mission -->
      <div class="col-span-1 md:col-span-1">
        <p class="font-body-sm text-[14px] leading-[21.7px] text-brand-gray mb-6">
          Inteligencia jurídica para litigantes del Ecuador.<br/>
          Construido con respeto por la profesión y por la verdad.
        </p>
      </div>

      <!-- Links -->
      <div class="md:col-span-3 grid grid-cols-1 sm:grid-cols-3 gap-8">
        <div>
          <h4 class="text-[#6e7278] font-semibold text-[12px] tracking-[1.2px] uppercase mb-5">Producto</h4>
          <ul class="space-y-4">
            <li><a href="#" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Búsqueda semántica</a></li>
            <li><a href="#" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Chat con sentencias</a></li>
            <li><a href="#" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Alertas</a></li>
            <li><a href="#" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Precios</a></li>
          </ul>
        </div>
        
        <div>
          <h4 class="text-[#6e7278] font-semibold text-[12px] tracking-[1.2px] uppercase mb-5">Compañía</h4>
          <ul class="space-y-4">
            <li><a href="#" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Nosotros</a></li>
            <li><a href="#" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Blog</a></li>
            <li><a href="#" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Carreras</a></li>
            <li><a href="#" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Contacto</a></li>
          </ul>
        </div>
        
        <div>
          <h4 class="text-[#6e7278] font-semibold text-[12px] tracking-[1.2px] uppercase mb-5">Legal</h4>
          <ul class="space-y-4">
            <li><a href="/terminos-de-servicio" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Términos</a></li>
            <li><a href="/privacidad" class="text-brand-gray text-[13.5px] hover:text-brand-dark transition-colors">Privacidad</a></li>
          </ul>
        </div>
      </div>

    </div>
    
    <div class="flex justify-between items-center pt-8 border-t border-[#e0e5eb]/50">
      <p class="text-[13px] text-brand-light-gray">© {currentYear} Argemus. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
