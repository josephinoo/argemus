---
---

<!-- Hero Section -->
<section class="text-center w-full max-w-5xl mx-auto min-h-[calc(100vh-64px)] py-8 lg:py-20 relative z-10 px-6 md:px-0 flex flex-col items-center justify-center">
  <div
    data-animate="hero"
    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs text-gray-950 mb-6 backdrop-blur-md border border-[#e0e5eb] bg-white/70 font-medium font-body-md shadow-[0px_1px_3px_0px_rgba(15,23,42,0.03)] shadow-[0px_1px_2px_0px_rgba(15,23,42,0.04)]"
  >
    <span class="bg-gray-950 text-white rounded-full p-[2px] flex items-center justify-center">
      <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
    </span>
    Nuevo · Inteligencia Jurídica 2.0
  </div>

  <h1
    id="hero-main-title"
    class="font-display text-[32px] sm:text-[44px] md:text-[64px] lg:text-[76px] text-gray-950 mb-6 tracking-normal leading-[1.1] opacity-0 max-w-[1134px] mx-auto"
  >
    Jurisprudencia
    <span class="italic text-blue-800 font-normal">ecuatoriana</span>
    <br class="hidden md:block" aria-hidden="true" />
    al alcance de una pregunta
  </h1>

  <p
    data-animate="hero"
    class="font-body-lg text-base sm:text-lg text-zinc-700 mb-8 max-w-[823px] mx-auto leading-7"
  >
    Accede a miles de sentencias de juzgados ecuatorianos organizadas con inteligencia artificial. Busca por problema jurídico y obtén resultados relevantes en segundos.
  </p>

  <div data-animate="hero" class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
    <a href="#" class="inline-flex items-center justify-center gap-2 w-56 h-11 bg-gray-950 text-white rounded-full font-medium text-sm hover:bg-gray-800 transition-colors shadow-[0px_1px_2px_0px_rgba(15,23,42,0.25)]">
      Empezar gratis · 14 días
      <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
    </a>
    <a href="#" class="inline-flex items-center justify-center w-44 h-11 bg-white/90 backdrop-blur-sm border border-white/50 text-gray-950 rounded-full font-medium text-sm hover:bg-white transition-colors shadow-[0px_1px_3px_0px_rgba(15,23,42,0.03)] shadow-[0px_1px_2px_0px_rgba(15,23,42,0.04)]">
      Ver cómo funciona
    </a>
  </div>

  <!-- Search UI Mockup -->
  <div data-animate="hero" class="relative w-full max-w-[840px] mx-auto rounded-[24px] overflow-visible">
    <!-- Background Blur effect behind mockup -->
    <div class="absolute -inset-4 bg-gradient-to-br from-[#ffd2aa]/50 to-[#aad2ff]/50 rounded-[32px] blur-2xl opacity-60 z-0"></div>

    <!-- Main Mockup Container -->
    <div class="relative z-10 bg-white/60 border border-white/60 rounded-[24px] shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] backdrop-blur-xl p-[6px]">
      <!-- Inner Search Bar Background -->
      <div class="bg-white border border-[#ebeff2] rounded-[18px] p-1.5 flex items-center justify-between shadow-sm relative z-20">
        
        <div class="flex items-center gap-3 w-full pl-4 pr-1 py-1 text-left">
          <span class="material-symbols-outlined text-brand-primary text-[22px]">psychology</span>
          <div class="flex-1 font-medium text-[14.5px] text-brand-dark truncate border-r border-[#ebeff2] py-2 pr-4 mr-2">
            Mi cliente fue despedido sin visto bueno tras 8 años de servicio
          </div>
          <button class="bg-brand-dark text-white text-[14px] font-medium rounded-xl px-3 sm:px-5 py-2.5 hover:bg-gray-800 transition-colors flex items-center gap-1.5 flex-shrink-0">
            <span class="material-symbols-outlined text-[16px]">search</span>
            <span class="hidden sm:inline">Buscar</span>
          </button>
        </div>
      </div>
      
      <!-- Filter Tags Row -->
      <div class="flex flex-wrap items-center justify-center gap-2 mt-4 relative z-20 pb-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-brand-dark text-white rounded-lg text-[12.5px] font-medium shadow-sm">
          <span class="material-symbols-outlined text-[14px]">tune</span> Criterio
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#ebeff2] text-brand-gray rounded-lg text-[12.5px] font-medium hover:bg-gray-50 transition-colors shadow-sm">
          <span class="material-symbols-outlined text-[14px]">language</span> General
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#ebeff2] text-brand-gray rounded-lg text-[12.5px] font-medium hover:bg-gray-50 transition-colors shadow-sm">
          <span class="material-symbols-outlined text-[14px]">gavel</span> Materia: Todas
        </div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-[#ebeff2] text-brand-gray rounded-lg text-[12.5px] font-medium hover:bg-gray-50 transition-colors shadow-sm">
          <span class="material-symbols-outlined text-[14px]">calendar_month</span> Año: 2020–2024
        </div>
      </div>
    </div>
    
    <!-- Floating Badges -->
    <div class="hidden lg:flex absolute -left-[12%] top-[-20px] z-30 bg-white/95 backdrop-blur-md border border-[#e0e5eb] shadow-[0_8px_16px_-6px_rgba(0,0,0,0.1)] rounded-full px-3.5 py-1.5 items-center gap-1.5">
      <span class="material-symbols-outlined text-brand-primary text-[15px]">timer</span>
      <span class="text-[12px] font-medium text-brand-dark">0.34s</span>
    </div>
    
    <div class="hidden lg:flex absolute -right-[15%] top-[-10px] z-30 bg-white/95 backdrop-blur-md border border-[#e0e5eb] shadow-[0_8px_16px_-6px_rgba(0,0,0,0.1)] rounded-full px-3.5 py-1.5 items-center gap-1.5">
      <span class="material-symbols-outlined text-brand-primary text-[15px]">account_balance</span>
      <span class="text-[12px] font-medium text-brand-dark">Corte Constitucional</span>
    </div>
    
    <div class="hidden lg:flex absolute right-[5%] -bottom-6 z-30 bg-white/95 backdrop-blur-md border border-[#e0e5eb] shadow-[0_8px_16px_-6px_rgba(0,0,0,0.1)] rounded-full px-3.5 py-1.5 items-center gap-1.5">
      <span class="material-symbols-outlined text-brand-primary text-[15px]">checklist</span>
      <span class="text-[12px] font-medium text-brand-dark">28 sentencias relevantes</span>
    </div>

  </div>
</section>



<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const title = document.getElementById("hero-main-title");
    if (!title) return;

    // Remove the initial opacity-0 class now that JS is running
    title.classList.remove("opacity-0");

    // Split text into words, but keep the HTML structure intact
    const originalHTML = title.innerHTML;
    // We'll use a simpler reveal for the hero since it has complex HTML (spans, brs)
    if (typeof gsap !== 'undefined') {
      gsap.fromTo(
        title,
        { y: 30, opacity: 0, filter: "blur(8px)" },
        {
          y: 0,
          opacity: 1,
          filter: "blur(0px)",
          duration: 1.2,
          ease: "power3.out",
          delay: 0.1,
          clearProps: "all",
        }
      );
    }
  });
</script>
