---
---
<!-- Hero Section -->
<section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap flex flex-col items-center text-center">
  <div class="bg-surface-container-low text-secondary font-label-sm text-label-sm px-3 py-1 rounded-DEFAULT mb-8 inline-flex items-center tracking-wider uppercase">
    IA PARA FIRMAS E IN-HOUSE LEGAL
  </div>
  <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-primary max-w-4xl mb-6 tracking-tight">
    Análisis inteligente de documentos para la abogacía de alto rendimiento.
  </h1>
  <p class="font-body-lg text-body-lg text-secondary max-w-2xl mb-12">
    Transforme su práctica jurídica con IA especializada. Analice contratos, acelere procesos de due diligence y mitigue riesgos operativos con la precisión que exigen los mejores equipos legales.
  </p>
  <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
    <a class="bg-primary text-on-primary font-label-md text-label-md px-6 py-3 rounded-DEFAULT hover:opacity-90 transition-opacity text-center w-full sm:w-auto" href="#">
      Solicitar Demo
    </a>
    <a class="bg-surface-elevated text-primary border border-border-base font-label-md text-label-md px-6 py-3 rounded-DEFAULT hover:bg-surface-container-low transition-colors text-center w-full sm:w-auto" href="#">
      Explorar plataforma
    </a>
  </div>
</section>

<!-- Product Interface Preview -->
<section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-section-gap">
  <div class="relative w-full aspect-video md:aspect-[21/9] rounded-xl overflow-hidden border border-border-base bg-surface-bright shadow-[0_10px_15px_-3px_rgba(0,0,0,0.04)]">
    <div class="absolute inset-0 flex flex-col">
      <!-- Fake Header -->
      <div class="h-12 border-b border-border-base flex items-center px-4 gap-4 bg-surface-elevated">
        <div class="flex gap-1.5">
          <div class="w-2.5 h-2.5 rounded-full bg-border-base"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border-base"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-border-base"></div>
        </div>
        <div class="h-6 w-64 bg-surface-container-low rounded border border-border-base"></div>
      </div>
      <!-- Fake Content Area -->
      <div class="flex-1 flex p-4 gap-4 bg-background-subtle">
        <!-- Document Viewer Pane -->
        <div class="flex-[2] bg-surface-elevated rounded border border-border-base p-6 shadow-sm flex flex-col gap-4 overflow-hidden">
          <div class="flex items-center justify-between mb-2">
            <div class="h-5 bg-surface-container-low rounded w-1/2"></div>
            <div class="flex gap-2">
              <div class="w-8 h-8 rounded-full bg-surface-container-low"></div>
              <div class="w-8 h-8 rounded-full bg-surface-container-low"></div>
            </div>
          </div>
          <div class="space-y-3">
            <div class="h-3 bg-surface-container-low/40 rounded w-full"></div>
            <div class="h-3 bg-surface-container-low/40 rounded w-full"></div>
            <div class="h-3 bg-surface-container-low/40 rounded w-11/12"></div>
            <div class="h-3 bg-surface-container-low/40 rounded w-full"></div>
            <div class="h-3 bg-surface-container-low/40 rounded w-10/12"></div>
            <div class="h-3 bg-surface-container-low/40 rounded w-full"></div>
            <div class="h-3 bg-surface-container-low/40 rounded w-9/12"></div>
            <div class="h-3 bg-surface-container-low/40 rounded w-full"></div>
            <div class="h-3 bg-surface-container-low/40 rounded w-full"></div>
            <div class="h-3 bg-surface-container-low/40 rounded w-11/12"></div>
          </div>
        </div>
        <!-- AI Insights Sidebar -->
        <div class="flex-1 flex flex-col gap-3">
          <div class="bg-primary/5 border border-primary/10 rounded p-4 flex flex-col gap-2">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary" style="font-size:16px">auto_awesome</span>
              <span class="font-label-md text-label-md text-primary uppercase font-bold tracking-tighter">Detección de Riesgos</span>
            </div>
            <div class="h-2 bg-primary/20 rounded w-3/4"></div>
            <div class="h-2 bg-primary/10 rounded w-full"></div>
          </div>
          <div class="bg-surface-elevated border border-border-base rounded p-4 flex flex-col gap-2 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary" style="font-size:16px">gavel</span>
              <span class="font-label-md text-label-md text-secondary uppercase font-bold tracking-tighter">Cláusulas Analizadas</span>
            </div>
            <div class="space-y-2">
              <div class="h-1.5 bg-surface-container-high rounded w-full"></div>
              <div class="h-1.5 bg-surface-container-high rounded w-5/6"></div>
              <div class="h-1.5 bg-surface-container-high rounded w-4/5"></div>
            </div>
          </div>
          <div class="bg-surface-elevated border border-border-base rounded p-4 flex flex-col gap-2 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary" style="font-size:16px">summarize</span>
              <span class="font-label-md text-label-md text-secondary uppercase font-bold tracking-tighter">Resumen Ejecutivo</span>
            </div>
            <div class="h-1.5 bg-surface-container-high rounded w-full"></div>
            <div class="h-1.5 bg-surface-container-high rounded w-2/3"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
