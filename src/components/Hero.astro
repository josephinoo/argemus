---
---

<!-- Hero Section -->
<section
  class="text-center w-full max-w-4xl mx-auto mb-24 pt-32 relative z-10 px-4 md:px-0"
>
  <div
    data-animate="hero"
    class="inline-flex items-center gap-2 px-3 py-1 rounded-full badge-glow text-xs text-gray-700 mb-8 backdrop-blur-sm"
  >
    <span
      class="text-primary material-symbols-outlined text-sm"
      style="font-variation-settings: 'FILL' 1;">auto_awesome</span
    >
    Nuevo: Inteligencia Jurídica 2.0
  </div>
  <h1
    id="hero-main-title"
    class="font-display text-5xl md:text-7xl text-gray-900 mb-6 font-bold tracking-tighter leading-tight opacity-0"
  >
    La inteligencia artificial para la jurisprudencia ecuatoriana.
  </h1>
  <p
    data-animate="hero"
    class="font-body-lg text-lg md:text-xl text-gray-500 mb-12 max-w-2xl mx-auto leading-relaxed"
  >
    Accede a miles de sentencias de juzgados ecuatorianos organizadas con
    inteligencia artificial. Busca por problema jurídico y obtén resultados
    relevantes en segundos.
  </p>

  <!-- Search Demo UI Mockup -->
  <div
    data-animate="hero"
    class="relative w-full max-w-4xl mx-auto mt-8 rounded-2xl border border-gray-200/50 bg-white/40 shadow-2xl overflow-hidden backdrop-blur-xl"
  >
    <!-- Mac OS Window Header -->
    <div
      class="h-12 bg-gray-50/80 border-b border-gray-200/50 flex items-center px-4 gap-2 backdrop-blur-md"
    >
      <div class="w-3 h-3 rounded-full bg-red-400"></div>
      <div class="w-3 h-3 rounded-full bg-amber-400"></div>
      <div class="w-3 h-3 rounded-full bg-green-400"></div>
      <div
        class="mx-auto flex-1 text-center text-xs font-medium text-gray-400 font-mono"
      >
        argemus.com/search
      </div>
    </div>

    <!-- Search Interface -->
    <div class="p-6 md:p-8 text-left">
      <div
        class="relative max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-gray-200 p-2 flex items-center mb-8 focus-within:ring-2 focus-within:ring-primary/20 transition-all"
      >
        <span
          class="material-symbols-outlined text-primary ml-3 mr-3"
          style="font-variation-settings: 'FILL' 0;">search</span
        >
        <input
          class="w-full bg-transparent border-none focus:ring-0 text-gray-900 placeholder-gray-400 outline-none py-2 text-base"
          placeholder="Ej. Hábeas corpus por detención arbitraria..."
          type="text"
          value="Hábeas corpus por detención arbitraria"
          readonly
        />
        <div
          class="bg-gray-100 text-gray-500 font-mono text-xs px-2 py-1 rounded-md ml-2 hidden md:block"
        >
          ⌘K
        </div>
      </div>

      <!-- Mock Results -->
      <div class="space-y-4 max-w-3xl mx-auto">
        <!-- Result 1 -->
        <div
          class="p-5 rounded-xl border border-gray-100 bg-white shadow-sm hover:shadow-md transition-shadow cursor-default group"
        >
          <div class="flex items-center justify-between mb-2">
            <span
              class="text-xs font-semibold tracking-wider text-primary uppercase bg-primary/5 px-2 py-1 rounded"
              >Corte Constitucional</span
            >
            <span class="text-xs text-gray-400">12 Feb 2024</span>
          </div>
          <h3
            class="font-bold text-gray-900 mb-2 group-hover:text-primary transition-colors"
          >
            Sentencia No. 123-24-HC/CC
          </h3>
          <p class="text-sm text-gray-600 line-clamp-2 leading-relaxed">
            Se declara la vulneración del derecho a la libertad personal debido
            a la detención arbitraria sin orden judicial competente ni delito
            flagrante, ordenando la inmediata liberación del accionante.
          </p>
          <div class="mt-4 flex gap-2">
            <span
              class="inline-flex items-center gap-1 px-2 py-1 bg-gray-50 text-gray-500 text-xs rounded-md border border-gray-100"
              ><span class="material-symbols-outlined text-[14px]">gavel</span> Hábeas
              Corpus</span
            >
            <span
              class="inline-flex items-center gap-1 px-2 py-1 bg-gray-50 text-gray-500 text-xs rounded-md border border-gray-100"
              ><span class="material-symbols-outlined text-[14px]">balance</span
              > Libertad Personal</span
            >
          </div>
        </div>

        <!-- Result 2 (Faded) -->
        <div
          class="p-5 rounded-xl border border-gray-100 bg-white/60 shadow-sm opacity-60"
        >
          <div class="flex items-center justify-between mb-2">
            <span
              class="text-xs font-semibold tracking-wider text-gray-500 uppercase bg-gray-100 px-2 py-1 rounded"
              >Corte Nacional de Justicia</span
            >
            <span class="text-xs text-gray-400">05 Nov 2023</span>
          </div>
          <div class="h-4 bg-gray-200 rounded w-2/3 mb-3"></div>
          <div class="h-3 bg-gray-100 rounded w-full mb-2"></div>
          <div class="h-3 bg-gray-100 rounded w-4/5 mb-2"></div>
        </div>
      </div>
    </div>

    <!-- Gradient overlay for fade out effect at bottom -->
    <div
      class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white/80 to-transparent pointer-events-none"
    >
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const title = document.getElementById("hero-main-title");
    if (!title) return;

    // Remove the initial opacity-0 class now that JS is running
    title.classList.remove("opacity-0");

    // Split text into words
    const text = title.innerText;
    title.innerHTML = "";

    const words = text.split(" ");
    words.forEach((word, index) => {
      const span = document.createElement("span");
      // Adding inline-block and hiding overflow for a "reveal from bottom" effect per word
      span.style.display = "inline-block";
      span.style.overflow = "hidden";
      span.style.verticalAlign = "bottom";
      // Adding margin-right for the space between words, except the last one
      if (index < words.length - 1) span.style.marginRight = "0.25em";

      const innerSpan = document.createElement("span");
      innerSpan.style.display = "inline-block";
      innerSpan.innerText = word;
      innerSpan.classList.add("hero-word-inner");

      span.appendChild(innerSpan);
      title.appendChild(span);
    });

    // Animate words discovering/rising up with Resend style (blur, fade up, no rotation)
    gsap.fromTo(
      ".hero-word-inner",
      { y: "100%", opacity: 0, filter: "blur(8px)", scale: 0.98 },
      {
        y: "0%",
        opacity: 1,
        filter: "blur(0px)",
        scale: 1,
        duration: 1.2,
        stagger: 0.04,
        ease: "power3.out",
        delay: 0.1,
        clearProps: "all",
      }
    );
  });
</script>
