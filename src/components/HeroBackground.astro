<!-- Three.js Hero Background — Linear-style particle network -->
<canvas id="hero-bg-canvas" aria-hidden="true"></canvas>

<style>
  #hero-bg-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  import * as THREE from 'three';

  // ── Scene setup ────────────────────────────────────────────────────────────
  const canvas = document.getElementById('hero-bg-canvas') as HTMLCanvasElement;
  if (!canvas) throw new Error('No canvas found');

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  camera.position.z = 28;

  // ── Particle grid ──────────────────────────────────────────────────────────
  const COLS = 22;
  const ROWS = 14;
  const SPREAD_X = 36;
  const SPREAD_Y = 22;
  const COUNT = COLS * ROWS;

  // Base positions
  const basePositions = new Float32Array(COUNT * 3);
  const phases = new Float32Array(COUNT); // random phase per particle

  for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
      const i = r * COLS + c;
      basePositions[i * 3]     = (c / (COLS - 1) - 0.5) * SPREAD_X;
      basePositions[i * 3 + 1] = (r / (ROWS - 1) - 0.5) * SPREAD_Y;
      basePositions[i * 3 + 2] = 0;
      phases[i] = Math.random() * Math.PI * 2;
    }
  }

  // Dots geometry
  const dotGeo = new THREE.BufferGeometry();
  const positions = new Float32Array(COUNT * 3);
  positions.set(basePositions);
  dotGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

  // Per-particle color (starts at primary navy, will be modulated)
  const colors = new Float32Array(COUNT * 3);
  dotGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  const dotMat = new THREE.PointsMaterial({
    size: 0.18,
    vertexColors: true,
    transparent: true,
    opacity: 0.55,
    sizeAttenuation: true,
  });

  const dots = new THREE.Points(dotGeo, dotMat);
  scene.add(dots);

  // ── Line segments between adjacent grid nodes ──────────────────────────────
  const linePositions: number[] = [];

  function addLine(ai: number, bi: number) {
    linePositions.push(
      basePositions[ai * 3], basePositions[ai * 3 + 1], basePositions[ai * 3 + 2],
      basePositions[bi * 3], basePositions[bi * 3 + 1], basePositions[bi * 3 + 2],
    );
  }

  for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
      if (c < COLS - 1) addLine(r * COLS + c, r * COLS + c + 1);       // horizontal
      if (r < ROWS - 1) addLine(r * COLS + c, (r + 1) * COLS + c);     // vertical
    }
  }

  const lineGeo = new THREE.BufferGeometry();
  const linePosAttr = new THREE.BufferAttribute(new Float32Array(linePositions), 3);
  lineGeo.setAttribute('position', linePosAttr);

  const lineMat = new THREE.LineSegmentsGeometry
    ? (() => {
        // fallback: plain LineSegments
        return new THREE.LineBasicMaterial({ color: 0xc4ccdc, transparent: true, opacity: 0.13 });
      })()
    : new THREE.LineBasicMaterial({ color: 0xc4ccdc, transparent: true, opacity: 0.13 });

  const lines = new THREE.LineSegments(lineGeo, lineMat as THREE.LineBasicMaterial);
  scene.add(lines);

  // ── Mouse tracking ─────────────────────────────────────────────────────────
  const mouse = new THREE.Vector2(0, 0);
  const mouseWorld = new THREE.Vector3(0, 0, 0);

  window.addEventListener('mousemove', (e) => {
    mouse.x = (e.clientX / window.innerWidth)  * 2 - 1;
    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
  });

  // ── Resize handler ─────────────────────────────────────────────────────────
  function onResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }
  window.addEventListener('resize', onResize);
  onResize();

  // ── Color helpers ──────────────────────────────────────────────────────────
  // Navy #001430 → rgb(0, 20, 48)
  const BASE_R = 0.0, BASE_G = 0.082, BASE_B = 0.188;
  // Accent blue #415f8f → rgb(65, 95, 143)
  const ACC_R  = 0.26, ACC_G  = 0.38, ACC_B  = 0.56;

  // ── Animation loop ─────────────────────────────────────────────────────────
  const clock = new THREE.Clock();

  // Unproject mouse to world plane z=0
  const raycaster = new THREE.Raycaster();

  function animate() {
    requestAnimationFrame(animate);
    const t = clock.getElapsedTime();

    // Map mouse to world coords
    raycaster.setFromCamera(mouse, camera);
    const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
    raycaster.ray.intersectPlane(plane, mouseWorld);

    const posArr = (dotGeo.attributes.position as THREE.BufferAttribute).array as Float32Array;
    const colArr = (dotGeo.attributes.color   as THREE.BufferAttribute).array as Float32Array;
    const linArr = (lineGeo.attributes.position as THREE.BufferAttribute).array as Float32Array;

    let li = 0; // line position index (mirrors addLine order)

    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const i = r * COLS + c;

        // Floating offset — gentle sine wave per particle
        const wave = Math.sin(t * 0.55 + phases[i]) * 0.18
                   + Math.cos(t * 0.35 + phases[i] * 1.3) * 0.10;
        const waveX = Math.cos(t * 0.4 + phases[i] * 0.7) * 0.12;

        const px = basePositions[i * 3]     + waveX;
        const py = basePositions[i * 3 + 1] + wave;
        const pz = basePositions[i * 3 + 2];

        posArr[i * 3]     = px;
        posArr[i * 3 + 1] = py;
        posArr[i * 3 + 2] = pz;

        // Distance from mouse → highlight nearby particles
        const dx = px - mouseWorld.x;
        const dy = py - mouseWorld.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const influence = Math.max(0, 1 - dist / 7); // radius 7 units

        // Lerp between base navy and accent blue
        colArr[i * 3]     = BASE_R + (ACC_R - BASE_R) * influence;
        colArr[i * 3 + 1] = BASE_G + (ACC_G - BASE_G) * influence;
        colArr[i * 3 + 2] = BASE_B + (ACC_B - BASE_B) * influence;
      }
    }

    // Update line positions to follow animated dots
    let lineIdx = 0;
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const i = r * COLS + c;
        // horizontal neighbour
        if (c < COLS - 1) {
          const j = r * COLS + c + 1;
          linArr[lineIdx++] = posArr[i * 3]; linArr[lineIdx++] = posArr[i * 3 + 1]; linArr[lineIdx++] = posArr[i * 3 + 2];
          linArr[lineIdx++] = posArr[j * 3]; linArr[lineIdx++] = posArr[j * 3 + 1]; linArr[lineIdx++] = posArr[j * 3 + 2];
        }
        // vertical neighbour
        if (r < ROWS - 1) {
          const j = (r + 1) * COLS + c;
          linArr[lineIdx++] = posArr[i * 3]; linArr[lineIdx++] = posArr[i * 3 + 1]; linArr[lineIdx++] = posArr[i * 3 + 2];
          linArr[lineIdx++] = posArr[j * 3]; linArr[lineIdx++] = posArr[j * 3 + 1]; linArr[lineIdx++] = posArr[j * 3 + 2];
        }
      }
    }

    (dotGeo.attributes.position as THREE.BufferAttribute).needsUpdate = true;
    (dotGeo.attributes.color   as THREE.BufferAttribute).needsUpdate = true;
    (lineGeo.attributes.position as THREE.BufferAttribute).needsUpdate = true;

    // Subtle camera drift following mouse
    camera.position.x += (mouse.x * 1.2 - camera.position.x) * 0.03;
    camera.position.y += (mouse.y * 0.8 - camera.position.y) * 0.03;
    camera.lookAt(scene.position);

    renderer.render(scene, camera);
  }

  animate();
</script>
