---
---

<section class="w-full relative z-10 py-14 md:py-24 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16" data-animate="fade-up">
      <span class="font-display text-blue-800 text-base md:text-lg mb-4 block">Cómo funciona</span>
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-gray-950 leading-[1.05] tracking-normal">
        De la duda al <span class="text-blue-800">precedente</span>,<br class="hidden sm:block"/>
        en tres pasos
      </h2>
    </div>

    <!-- Steps Grid -->
    <div data-animate-group class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      
      <!-- Step 1 -->
      <div data-animate="stagger" class="bg-white rounded-3xl outline outline-1 outline-offset-[-1px] outline-gray-200 p-8 pt-10 flex flex-col h-full relative z-10">
        <div class="text-blue-800 text-6xl font-display leading-[50.40px] mb-8">01</div>
        <h3 class="text-gray-950 text-xl font-display leading-7 mb-4">Describe tu problema jurídico</h3>
        <p class="text-zinc-700 text-sm leading-6">En lenguaje natural — como se lo contarías a un colega. Sin operadores booleanos, sin trucos.</p>
      </div>

      <!-- Step 2 -->
      <div data-animate="stagger" class="bg-white rounded-3xl outline outline-1 outline-offset-[-1px] outline-gray-200 p-8 pt-10 flex flex-col h-full relative z-10">
        <div class="text-blue-800 text-6xl font-display leading-[50.40px] mb-8">02</div>
        <h3 class="text-gray-950 text-xl font-display leading-7 mb-4">Argemus encuentra la jurisprudencia</h3>
        <p class="text-zinc-700 text-sm leading-6">Nuestros modelos comparan tu caso contra miles de sentencias y ranquean por similitud semántica.</p>
      </div>

      <!-- Step 3 -->
      <div data-animate="stagger" class="bg-white rounded-3xl outline outline-1 outline-offset-[-1px] outline-gray-200 p-8 pt-10 flex flex-col h-full relative z-10">
        <div class="text-blue-800 text-6xl font-display leading-[50.40px] mb-8">03</div>
        <h3 class="text-gray-950 text-xl font-display leading-7 mb-4">Conversa y construye tu argumento</h3>
        <p class="text-zinc-700 text-sm leading-6">Selecciona los fallos relevantes y dialoga con ellos para extraer ratio decidendi, jueces y criterios.</p>
      </div>

    </div>
  </div>
</section>
