<!-- Stats Section -->
<section class="w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop border-y border-outline-variant py-lg mb-section-gap">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter" data-animate-group>
    <div class="text-center" data-animate="stagger">
      <div class="font-headline-lg text-headline-lg text-primary mb-xs">10M+</div>
      <div class="font-body-sm text-body-sm text-on-surface-variant">Sentencias Procesadas</div>
    </div>
    <div class="text-center border-outline-variant md:border-l pt-md md:pt-0" data-animate="stagger">
      <div class="font-headline-lg text-headline-lg text-primary mb-xs">&lt; 1s</div>
      <div class="font-body-sm text-body-sm text-on-surface-variant">Tiempo de respuesta</div>
    </div>
    <div class="text-center border-outline-variant md:border-l pt-md md:pt-0" data-animate="stagger">
      <div class="font-headline-lg text-headline-lg text-primary mb-xs">99.9%</div>
      <div class="font-body-sm text-body-sm text-on-surface-variant">Precisión</div>
    </div>
  </div>
</section>
