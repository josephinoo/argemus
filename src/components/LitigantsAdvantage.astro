---
import { Image } from 'astro:assets';
import bg2 from '../assets/bg-2.jpg';
---

<section class="w-full relative z-10 py-14 md:py-24 px-4 bg-white overflow-hidden">
  <div class="max-w-6xl mx-auto flex flex-col lg:flex-row-reverse gap-10 lg:gap-12 xl:gap-16 items-center">
    
    <!-- Right Content (Text) -->
    <div data-animate="fade-up" class="flex-1 min-w-0 w-full mx-auto lg:mx-0 text-center lg:text-left">
      <span class="font-display text-blue-800 text-sm md:text-lg mb-4 block">Construido para el oficio</span>
      
      <h2 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-gray-950 leading-[1.05] tracking-normal mb-6">
        Más argumentos.<br class="hidden sm:block"/>
        <span class="text-blue-900">Menos archivos abiertos</span>
      </h2>
      
      <p class="font-body-lg text-zinc-700 text-base leading-7 mb-8">
        Argemus no reemplaza el criterio del litigante — lo amplifica. Donde antes necesitabas días para encontrar el precedente exacto, ahora encuentras tres opciones complementarias en segundos.
      </p>

      <ul class="space-y-6 mb-10 text-left">
        <li class="flex items-start gap-4">
          <div class="mt-0.5 bg-blue-800/10 rounded-full p-1.5 flex-shrink-0">
            <span class="material-symbols-outlined text-blue-800 text-[16px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
          </div>
          <p class="text-base leading-6 text-gray-950">
            <span class="font-semibold">Citas verificables</span>
            <span class="text-zinc-700 font-normal"> — cada respuesta vinculada al fragmento fuente.</span>
          </p>
        </li>
        <li class="flex items-start gap-4">
          <div class="mt-0.5 bg-blue-800/10 rounded-full p-1.5 flex-shrink-0">
            <span class="material-symbols-outlined text-blue-800 text-[16px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
          </div>
          <p class="text-base leading-6 text-gray-950">
            <span class="font-semibold">Multi-sentencia</span>
            <span class="text-zinc-700 font-normal"> — compara hasta 10 fallos en un solo hilo.</span>
          </p>
        </li>
        <li class="flex items-start gap-4">
          <div class="mt-0.5 bg-blue-800/10 rounded-full p-1.5 flex-shrink-0">
            <span class="material-symbols-outlined text-blue-800 text-[16px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
          </div>
          <p class="text-base leading-6 text-gray-950">
            <span class="font-semibold">Historial persistente</span>
            <span class="text-zinc-700 font-normal"> — retoma tus investigaciones cuando quieras.</span>
          </p>
        </li>
      </ul>

      <a href="#" class="inline-flex items-center justify-center gap-2 w-40 h-11 bg-gray-950 text-white rounded-full font-medium text-sm hover:bg-gray-800 transition-colors shadow-[0px_1px_2px_0px_rgba(15,23,42,0.25)] mx-auto lg:mx-0 block text-center">
        Probar gratis
        <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
      </a>
    </div>

    <!-- Left Image/Mockup -->
    <div data-animate="fade-right" class="w-full lg:w-[500px] xl:w-[548px] flex-shrink-0 relative mt-10 lg:mt-0">
      <div class="bg-gray-100 rounded-3xl shadow-[0_30px_70px_-24px_rgba(30,30,80,0.22)] overflow-hidden flex aspect-[4/5] w-full relative">
        <Image src={bg2} class="w-full h-full object-cover" alt="Plataforma Argemus" />
        
        <!-- Floating Stat Card -->
        <div class="absolute bottom-6 sm:bottom-10 right-4 sm:-right-4 lg:-right-10 bg-white/95 rounded-2xl backdrop-blur-md shadow-xl p-3 sm:p-4 flex items-center gap-3 sm:gap-4 max-w-[90%] sm:max-w-none">
          <div class="flex items-baseline">
            <span class="font-display text-4xl text-gray-950">85</span>
            <span class="font-display text-3xl text-blue-800">%</span>
          </div>
          <p class="text-zinc-700 text-xs leading-4">
            menos tiempo<br/>investigando precedentes
          </p>
        </div>
      </div>
    </div>

  </div>
</section>
