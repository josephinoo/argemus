---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, "");
---
<!-- Skip to content -->
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-primary focus:text-white focus:px-4 focus:py-2 focus:rounded font-medium">
  Saltar al contenido
</a>
<!-- TopNavBar -->
<header id="main-nav" class="glass-nav fixed w-full top-0 z-50">
  <div class="flex justify-between items-center w-full px-4 md:px-16 h-16 max-w-7xl mx-auto">
    <div class="font-bold text-xl text-gray-900 tracking-tight flex items-center gap-2">
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
        <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 1;">gavel</span>
        Argemus
      </a>
    </div>
    <nav aria-label="Navegación principal" class="hidden md:flex gap-8 items-center">
      <a class={`text-sm transition-colors duration-150 ${currentPath === '/' ? 'text-gray-900 font-medium' : 'text-gray-600 hover:text-gray-900'}`} href="/">Jurisprudencia</a>
      <a class={`text-sm transition-colors duration-150 ${currentPath === '/precios' ? 'text-gray-900 font-medium' : 'text-gray-600 hover:text-gray-900'}`} href="/precios">Precios</a>
      <a class={`text-sm transition-colors duration-150 ${currentPath === '/metodologia' ? 'text-gray-900 font-medium' : 'text-gray-600 hover:text-gray-900'}`} href="/metodologia">Metodología</a>
      <a class={`text-sm transition-colors duration-150 ${currentPath === '/contacto' ? 'text-gray-900 font-medium' : 'text-gray-600 hover:text-gray-900'}`} href="/contacto">Contacto</a>
    </nav>
    <div class="flex gap-3 items-center">
      <a class="hidden md:block text-sm text-gray-600 hover:text-gray-900 transition-colors cursor-pointer" href="#">Iniciar Sesión</a>
      <a class="text-sm text-white bg-primary px-4 py-1.5 rounded-full font-medium hover:bg-primary-container transition-colors cursor-pointer" href="#">Empezar Gratis</a>
      <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center p-1.5 text-gray-900 rounded-lg hover:bg-gray-100 transition-colors" aria-label="Abrir menú" aria-expanded="false">
        <span class="material-symbols-outlined" id="menu-icon">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="md:hidden hidden flex-col bg-white/95 backdrop-blur-xl border-t border-gray-100 px-4 py-6 gap-1 shadow-lg"
    role="navigation"
    aria-label="Menú móvil"
  >
    <a class={`text-base py-3 border-b border-gray-100 transition-colors ${currentPath === '/' ? 'text-gray-900 font-semibold' : 'text-gray-600 hover:text-gray-900'}`} href="/">Jurisprudencia</a>
    <a class={`text-base py-3 border-b border-gray-100 transition-colors ${currentPath === '/precios' ? 'text-gray-900 font-semibold' : 'text-gray-600 hover:text-gray-900'}`} href="/precios">Precios</a>
    <a class={`text-base py-3 border-b border-gray-100 transition-colors ${currentPath === '/metodologia' ? 'text-gray-900 font-semibold' : 'text-gray-600 hover:text-gray-900'}`} href="/metodologia">Metodología</a>
    <a class={`text-base py-3 border-b border-gray-100 transition-colors ${currentPath === '/contacto' ? 'text-gray-900 font-semibold' : 'text-gray-600 hover:text-gray-900'}`} href="/contacto">Contacto</a>
    <div class="flex flex-col gap-3 pt-4">
      <a href="#" class="text-center text-sm text-gray-700 font-medium py-2.5 border border-gray-200 rounded-full hover:bg-gray-50 transition-colors">Iniciar Sesión</a>
      <a href="#" class="text-center text-sm text-white bg-primary py-2.5 rounded-full font-medium hover:bg-primary-container transition-colors">Empezar Gratis</a>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  if (btn && menu && icon) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        icon.textContent = 'menu';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        icon.textContent = 'close';
        btn.setAttribute('aria-expanded', 'true');
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        icon.textContent = 'menu';
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
