---
---
<nav id="main-nav">
  <div class="container nav-content">
    <div class="logo">
      <a href="/">ARGEMUS</a>
    </div>
    <ul class="nav-links">
      <li><a href="#soluciones">Soluciones</a></li>
      <li><a href="#impacto">Impacto</a></li>
      <li><a href="#empresa">Empresa</a></li>
    </ul>
    <div class="nav-actions">
      <a href="/login" class="login-link">Iniciar Sesión</a>
      <button class="cta-button">Solicitar demo</button>
    </div>
  </div>
</nav>

<style>
  #main-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--header-height);
    z-index: 1000;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
  }

  #main-nav.scrolled {
    background-color: rgba(7, 9, 20, 0.72);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    height: 74px;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .logo a {
    font-size: 0.96rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .nav-links {
    display: flex;
    gap: 1.6rem;
    list-style: none;
  }

  .nav-links a {
    font-size: 0.84rem;
    letter-spacing: 0.02em;
    font-weight: 500;
    color: var(--color-muted);
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .login-link {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--color-muted);
  }

  .login-link:hover {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    #main-nav {
      height: 68px;
    }

    #main-nav.scrolled {
      height: 62px;
    }

    .nav-links {
      display: none;
    }

    .nav-actions {
      gap: 0.65rem;
    }

    .login-link {
      display: none;
    }

    .nav-actions .cta-button {
      padding: 0.5rem 0.85rem;
      font-size: 0.78rem;
    }

    .logo a {
      font-size: 0.88rem;
      letter-spacing: 0.17em;
    }
  }

  @media (max-width: 420px) {
    .logo a {
      letter-spacing: 0.14em;
    }
  }
</style>

<script>
  const nav = document.getElementById('main-nav');
  if (nav) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    });
  }
</script>
