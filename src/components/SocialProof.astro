---
<section class="social-proof">
  <div class="container">
    <p class="section-label">Con la confianza de equipos legales de alto desempeño</p>
    <div class="logos-grid">
      <div class="logo-item">GARRIGUES</div>
      <div class="logo-item">CUATRECASAS</div>
      <div class="logo-item">URÍA MENÉNDEZ</div>
      <div class="logo-item">PÉREZ-LLORCA</div>
      <div class="logo-item">CLIFFORD CHANCE</div>
    </div>
  </div>
</section>

<style>
  .social-proof {
    background-color: transparent;
    padding: 1.5rem 0 var(--spacing-lg);
  }

  .section-label {
    text-align: center;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 2.25rem;
    opacity: 0.88;
  }

  .logos-grid {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    animation: fadeIn 900ms ease both;
  }

  .logo-item {
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.09em;
    color: rgba(232, 237, 255, 0.78);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .logo-item:hover {
    transform: translateY(-2px);
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .section-label {
      font-size: 0.72rem;
      margin-bottom: 1.4rem;
    }

    .logos-grid {
      justify-content: center;
      gap: 0.9rem 1.2rem;
      display: grid;
      grid-template-columns: repeat(2, minmax(120px, 1fr));
      text-align: center;
    }

    .logo-item {
      font-size: 0.82rem;
      letter-spacing: 0.05em;
    }
  }

  @media (max-width: 420px) {
    .logos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
