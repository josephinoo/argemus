---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	image?: string;
	url?: string;
	type?: string;
	locale?: string;
	noindex?: boolean;
}

const {
	title,
	description = "Argemus es la plataforma de IA diseñada para firmas de abogados y departamentos legales de élite. Automatiza flujos de trabajo complejos, extrae información crítica al instante y reduce el riesgo con precisión empresarial.",
	image = "/og-image.png",
	url = Astro.url.href,
	type = "website",
	locale = "es_ES",
	noindex = false,
} = Astro.props;

const siteName = "Argemus AI";
const fullTitle = title.includes("Argemus") ? title : `${title} | ${siteName}`;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "Argemus AI",
	applicationCategory: "LegalTech",
	operatingSystem: "Web",
	description: description,
	url: Astro.site ?? "https://argemus.com",
	offers: {
		"@type": "Offer",
		availability: "https://schema.org/InStock",
		priceCurrency: "USD",
	},
	provider: {
		"@type": "Organization",
		name: "Argemus AI Corporation",
		url: Astro.site ?? "https://argemus.com",
		sameAs: [],
	},
};
---

<!DOCTYPE html>
<html lang="es" class="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta -->
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Argemus AI Corporation" />
		<meta
			name="keywords"
			content="IA legal, inteligencia artificial abogados, análisis contratos IA, due diligence IA, legaltech, plataforma jurídica IA, gestión riesgos legal, investigación jurídica automatizada"
		/>
		{
			noindex ? (
				<meta name="robots" content="noindex, nofollow" />
			) : (
				<meta
					name="robots"
					content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
				/>
			)
		}

		<!-- Canonical -->
		<link rel="canonical" href={url} />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content={`${siteName} - Práctica Jurídica Perfeccionada`}
		/>
		<meta property="og:url" content={url} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={locale} />

		<!-- Twitter / X Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta
			name="twitter:image:alt"
			content={`${siteName} - Práctica Jurídica Perfeccionada`}
		/>

		<!-- Theme color -->
		<meta name="theme-color" content="#000000" />
		<meta name="msapplication-TileColor" content="#000000" />

		<!-- Schema.org JSON-LD -->
		<script
			type="application/ld+json"
			set:html={JSON.stringify(structuredData)}
		></script>

		<!-- Preconnect for performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />

		<!-- GSAP -->
		<script
			defer
			src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"
		></script>
		<script
			defer
			src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"
		></script>

		<!-- Lenis Smooth Scroll -->
		<script
			defer
			src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"
		></script>

		<!-- Hide animated elements before JS runs to prevent flash -->
		<style>
			[data-animate], [data-animate="stagger"], #main-nav {
				opacity: 0;
			}
		</style>
	</head>
	<body
		class="bg-background text-on-background font-body-md antialiased overflow-x-hidden selection:bg-primary-container selection:text-on-primary-container"
	>
		<slot />

		<!-- Global GSAP Animations & Smooth Scroll -->
		<script is:inline>
			document.addEventListener("DOMContentLoaded", function () {
				// Initialize Lenis
				const lenis = new Lenis({
					duration: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					direction: "vertical",
					gestureDirection: "vertical",
					smooth: true,
					mouseMultiplier: 1,
					smoothTouch: false,
					touchMultiplier: 2,
					infinite: false,
				});

				// Connect Lenis to GSAP ScrollTrigger
				lenis.on("scroll", ScrollTrigger.update);
				gsap.ticker.add((time) => {
					lenis.raf(time * 1000);
				});
				gsap.ticker.lagSmoothing(0);

				gsap.registerPlugin(ScrollTrigger);

				// ── Navbar: slide down on page load ────────────────────────────
				const nav = document.getElementById("main-nav");
				if (nav) {
					gsap.fromTo(
						nav,
						{ opacity: 0, y: -20 },
						{
							opacity: 1,
							y: 0,
							duration: 1,
							ease: "power3.out",
							clearProps: "all",
						}
					);
				}

				// ── Hero: staggered entrance on page load ──────────────────
				const heroEls = document.querySelectorAll(
					'[data-animate="hero"]'
				);
				if (heroEls.length) {
					gsap.fromTo(
						heroEls,
						{ opacity: 0, y: 40, filter: "blur(8px)", scale: 0.98 },
						{
							opacity: 1,
							y: 0,
							filter: "blur(0px)",
							scale: 1,
							duration: 1.2,
							ease: "power3.out",
							stagger: 0.15,
							delay: 0.1,
							clearProps: "transform,filter,scale",
						}
					);
				}

				// ── Scroll-triggered fade-up/left/right (individual elements) ─────────
				const animateEls = document.querySelectorAll('[data-animate="fade-up"], [data-animate="fade-left"], [data-animate="fade-right"]');
				animateEls.forEach(function (el) {
					const animationType = el.getAttribute('data-animate');
					let startProps = { opacity: 0, filter: "blur(8px)", scale: 0.98 };
					
					if (animationType === 'fade-up') startProps.y = 40;
					if (animationType === 'fade-left') startProps.x = 40; // Animates from right to left
					if (animationType === 'fade-right') startProps.x = -40; // Animates from left to right

					gsap.fromTo(
						el,
						startProps,
						{
							opacity: 1,
							x: 0,
							y: 0,
							filter: "blur(0px)",
							scale: 1,
							duration: 1.2,
							ease: "power3.out",
							clearProps: "transform,filter,scale",
							scrollTrigger: {
								trigger: el,
								start: "top 85%",
								once: true,
							},
						}
					);
				});

				// ── Scroll-triggered stagger groups ────────────────────────
				document
					.querySelectorAll("[data-animate-group]")
					.forEach(function (group) {
						const children = group.querySelectorAll(
							'[data-animate="stagger"]'
						);
						if (!children.length) return;
						gsap.fromTo(
							children,
							{
								opacity: 0,
								y: 40,
								filter: "blur(8px)",
								scale: 0.98,
							},
							{
								opacity: 1,
								y: 0,
								filter: "blur(0px)",
								scale: 1,
								duration: 1.2,
								ease: "power3.out",
								stagger: 0.15,
								clearProps: "transform,filter,scale",
								scrollTrigger: {
									trigger: group,
									start: "top 85%",
									once: true,
								},
							}
						);
					});
			});
		</script>
	</body>
</html>
