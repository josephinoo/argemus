---
import Layout from '../layouts/Layout.astro';
import HeroBackground from '../components/HeroBackground.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ImpactStats from '../components/ImpactStats.astro';
import FeatureSection from '../components/FeatureSection.astro';
import PlatformFeatures from '../components/PlatformFeatures.astro';
import LitigantsAdvantage from '../components/LitigantsAdvantage.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Testimonials from '../components/Testimonials.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Argemus | Inteligencia artificial para la jurisprudencia ecuatoriana">
  <Navbar />
  
  <HeroBackground />

  <main class="flex-grow flex flex-col pt-16 w-full relative z-10" id="main-content">
    
    <!-- Hero & Demo Section -->
    <div class="relative w-full mb-8 z-20">
      <Hero />
    </div>

    <!-- Impact Stats Section -->
    <div class="w-full max-w-6xl mx-auto px-4 relative z-30 -mt-10 mb-20">
      <div class="bg-white rounded-3xl outline outline-1 outline-offset-[-1px] outline-gray-200 shadow-lg relative overflow-hidden" data-animate="fade-up">
        <ImpactStats />
      </div>
    </div>

    <!-- Platform Features Grid (La plataforma) -->
    <PlatformFeatures />

    <!-- Litigants Advantage (Construido para el oficio) -->
    <LitigantsAdvantage />

    <!-- Features Section (Pregunta. Profundiza. Decide.) -->
    <FeatureSection />

    <!-- How It Works (Cómo funciona) -->
    <HowItWorks />

    <!-- Testimonials (Nuestros Clientes) -->
    <Testimonials />

  </main>

  <Footer />
</Layout>
